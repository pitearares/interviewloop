generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum-like fields are kept as plain strings (a SQLite-era decision that
// still keeps the app code simple) and validated in application code.
// Difficulty: "EASY" | "MEDIUM"
// Topic: "ARRAYS_STRINGS" | "ALGORITHMS" | "DATA_STRUCTURES" | "DYNAMIC_PROGRAMMING"
//        | "LANGUAGE_FUNDAMENTALS" | "OOP" | "COLLECTIONS" | "MEMORY_MANAGEMENT"
// Kind: "CODING" | "THEORY"
// Track: "GENERAL" | "JAVA" | "CPP"
// SessionStatus: "IN_PROGRESS" | "COMPLETED" | "ABANDONED"
// TranscriptEventType: "CODE_SNAPSHOT" | "INTERVIEWER_QUESTION" | "INTERVIEWER_NUDGE" | "CANDIDATE_ANSWER" | "SYSTEM_NOTE"
// Verdict: "STRONG_HIRE" | "HIRE" | "LEANING_NO" | "NO"

model Problem {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  difficulty      String
  topic           String
  kind            String   @default("CODING") // CODING = editor + tests, THEORY = oral Q&A
  track           String   @default("GENERAL") // which interview track this belongs to
  prompt          String // markdown problem statement (THEORY: the interviewer's question bank)
  constraints     String // markdown constraints list (THEORY: interview format notes)
  examples        String // JSON-encoded array of {input, output, explanation}
  starterCodeJs   String
  starterCodePy   String
  starterCodeJava String   @default("")
  starterCodeCpp  String   @default("")
  testCases       String // JSON-encoded array of {input, expected}
  createdAt       DateTime @default(now())

  sessions InterviewSession[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // scrypt: salt:hash, both hex
  createdAt    DateTime @default(now())

  sessions     InterviewSession[]
  authSessions AuthSession[]
}

// Opaque login tokens, stored server-side so logout genuinely revokes access.
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model InterviewSession {
  id          String    @id @default(cuid())
  problemId   String
  problem     Problem   @relation(fields: [problemId], references: [id])
  // Optional so sessions recorded before accounts existed keep working.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  status      String    @default("IN_PROGRESS")
  language    String    @default("javascript")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int? // wall-clock duration once ended

  transcriptEntries TranscriptEntry[]
  evaluationReport  EvaluationReport?
}

model TranscriptEntry {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  type      String
  content   String // code snapshot, question text, nudge text, or candidate answer
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model EvaluationReport {
  id            String           @id @default(cuid())
  sessionId     String           @unique
  session       InterviewSession @relation(fields: [sessionId], references: [id])
  verdict       String
  correctness   String // markdown assessment
  communication String // markdown assessment
  codeQuality   String // markdown assessment
  advice        String // JSON-encoded array of 2-3 strings
  createdAt     DateTime         @default(now())
}
